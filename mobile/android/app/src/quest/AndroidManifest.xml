<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- A Quest/OpenXR build is meaningful only on a stereoscopic headset. -->
  <uses-feature
      android:name="android.hardware.vr.headtracking"
      android:required="true"
      android:version="1" />

  <!-- Deliberately retain the base manifest's ordinary LAUNCHER category.
       Gen1Recomp must present its ROM/mod importer before an XR session can
       exist. Marking this Activity as com.oculus.intent.category.VR makes
       Horizon enter immersive mode before that workflow and stops SDL's
       surface when no OpenXR frames are submitted yet. The mod transitions
       to OpenXR only after the player enables its VR setting. -->
</manifest>
